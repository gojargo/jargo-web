{
  "name": "jargo-web",
  "version": "0.0.0",
  "private": true,
  "description": "jargo web toolkit — headless client, framework-agnostic UI (Orb), and framework bindings, plus a Next.js example.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @gojargo/jargo-client-js -w @gojargo/jargo-ui -w @gojargo/jargo-client-react -w @gojargo/jargo-client-vue -w @gojargo/jargo-elements",
    "typecheck": "npm run typecheck -w @gojargo/jargo-client-js -w @gojargo/jargo-ui -w @gojargo/jargo-client-react -w @gojargo/jargo-client-vue -w @gojargo/jargo-elements",
    "dev:example": "npm run dev -w jargo-nextjs-voicebot",
    "example": "npm run dev -w jargo-nextjs-voicebot"
  }
}
