{
  "name": "@gojargo/jargo-ui",
  "version": "0.1.0",
  "description": "Framework-agnostic UI for jargo voice clients — the Orb (audio-reactive moving lines) and visualizers.",
  "license": "BSD-2-Clause",
  "author": "the jargo authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojargo/jargo-web.git",
    "directory": "packages/jargo-ui"
  },
  "keywords": ["jargo", "orb", "visualizer", "voice-ai", "ui", "canvas"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "theme.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  }
}
