{
  "name": "@gojargo/jargo-client-js",
  "version": "0.1.0",
  "description": "Headless classic-WebRTC + RTVI browser client for jargo voice servers. Framework-agnostic.",
  "license": "BSD-2-Clause",
  "author": "the jargo authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojargo/jargo-web.git",
    "directory": "packages/jargo-client-js"
  },
  "keywords": ["jargo", "webrtc", "rtvi", "voice-ai"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  }
}
