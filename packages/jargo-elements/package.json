{
  "name": "@gojargo/jargo-elements",
  "version": "0.1.0",
  "description": "Web components for jargo — <jargo-orb>, a custom element wrapping the Orb.",
  "license": "BSD-2-Clause",
  "author": "the jargo authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gojargo/jargo-web.git",
    "directory": "packages/jargo-elements"
  },
  "keywords": ["jargo", "web-components", "custom-elements", "orb", "voice-ai"],
  "type": "module",
  "sideEffects": ["./dist/define.js", "./dist/define.cjs"],
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js",
      "require": "./dist/define.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gojargo/jargo-ui": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8",
    "typescript": "^5"
  }
}
